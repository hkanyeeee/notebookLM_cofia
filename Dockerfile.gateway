FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# 只安装 gateway 所需的基本依赖
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# 创建一个最小化的 requirements 文件用于 gateway
# 只需要 fastapi, uvicorn, httpx 等基本依赖
COPY gateway_requirements.txt ./
RUN pip install --no-cache-dir -r gateway_requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# 只复制 gateway 脚本
COPY ./gateway_script/embedding_gateway.py ./gateway_script/llm_gateway.py ./

WORKDIR /app

